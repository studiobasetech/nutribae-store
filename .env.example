# Copy this file to ".env" for local testing ONLY with sandbox/test keys.
# .env is ignored by git. Never put live keys in any file.
# On Netlify, set these under Site configuration → Environment variables (mark as secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
JUDGEME_PRIVATE_TOKEN=

# Signs the free cookbook links (any long random text; keep it the same forever)
COOKBOOK_SECRET=

# App notifications (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourstore.com
PUSH_ADMIN_KEY=
